{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cora-historico-digital/schemas/canonicalization-plan.schema.json",
  "title": "CHD Canonicalization Plan",
  "description": "Machine-generated phase-3 materialization plan derived only from complete, validated human reconciliation decisions. The plan assigns future article identifiers but does not rewrite lexical text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "project_phase",
    "source_witness_id",
    "machine_generated",
    "derived_from_human_verified_decisions",
    "human_decision_coverage_complete",
    "ready_for_canonicalization",
    "candidate_total",
    "human_decision_records",
    "planned_article_total",
    "excluded_candidate_total",
    "decision_counts_by_action",
    "article_counts_by_source_type",
    "articles",
    "excluded_candidates",
    "method_note"
  ],
  "properties": {
    "artifact_type": {"const": "canonicalization_plan"},
    "project_phase": {"const": 3},
    "source_witness_id": {"const": "ORTEGA1888-TEPIC-IA"},
    "machine_generated": {"const": true},
    "derived_from_human_verified_decisions": {"const": true},
    "human_decision_coverage_complete": {"const": true},
    "ready_for_canonicalization": {"const": true},
    "candidate_total": {"type": "integer", "minimum": 0},
    "human_decision_records": {"type": "integer", "minimum": 0},
    "planned_article_total": {"type": "integer", "minimum": 0},
    "excluded_candidate_total": {"type": "integer", "minimum": 0},
    "decision_counts_by_action": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "article_counts_by_source_type": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "articles": {
      "type": "array",
      "items": {"$ref": "#/$defs/article"}
    },
    "excluded_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/excludedCandidate"}
    },
    "method_note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^ORT1888-cand-[0-9]{6}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^ORT1888-rec-[0-9]{6}$"
    },
    "articleId": {
      "type": "string",
      "pattern": "^ORT1888-art-[0-9]{6}$"
    },
    "ocrSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ocr_line_start", "source_ocr_line_end"],
      "properties": {
        "source_ocr_line_start": {"type": "integer", "minimum": 1},
        "source_ocr_line_end": {"type": "integer", "minimum": 1}
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_id",
        "decision_id",
        "decision_action",
        "source_type",
        "source_candidate_ids",
        "source_pdf_pages",
        "sort_order"
      ],
      "properties": {
        "article_id": {"$ref": "#/$defs/articleId"},
        "decision_id": {"$ref": "#/$defs/decisionId"},
        "decision_action": {
          "enum": ["accept_boundary", "merge_candidates", "split_candidate"]
        },
        "source_type": {
          "enum": ["accepted_candidate", "merged_candidates", "candidate_span"]
        },
        "source_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateId"}
        },
        "source_pdf_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "sort_order": {"type": "integer", "minimum": 1},
        "split_index": {"type": "integer", "minimum": 1},
        "source_ocr_span": {"$ref": "#/$defs/ocrSpan"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"const": "candidate_span"}}},
          "then": {"required": ["split_index", "source_ocr_span"]}
        }
      ]
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "candidate_id", "candidate_order", "reason"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/decisionId"},
        "candidate_id": {"$ref": "#/$defs/candidateId"},
        "candidate_order": {"type": "integer", "minimum": 1},
        "reason": {"const": "human_rejected_false_boundary"}
      }
    }
  }
}
