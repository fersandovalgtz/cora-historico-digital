{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cora-historico-digital/schemas/reconciliation-queue-item.schema.json",
  "title": "CHD Reconciliation Queue Item",
  "description": "Machine-generated prioritization record for human boundary review. Queue placement is not a linguistic or philological judgment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_rank",
    "candidate_id",
    "candidate_order",
    "source_pdf_page",
    "source_printed_page",
    "priority_score",
    "priority_reasons",
    "page_alignment_status",
    "extraction_confidence",
    "multiple_separator_flag",
    "headword_es_ocr",
    "cora_ocr",
    "raw_span_ocr",
    "review_status",
    "human_verified"
  ],
  "properties": {
    "queue_rank": {"type": ["integer", "string"]},
    "candidate_id": {"type": "string", "pattern": "^ORT1888-cand-[0-9]{6}$"},
    "candidate_order": {"type": ["integer", "string"]},
    "source_pdf_page": {"type": ["integer", "string"]},
    "source_printed_page": {"type": ["integer", "string"]},
    "priority_score": {"type": ["integer", "string"]},
    "priority_reasons": {"type": "string", "minLength": 1},
    "page_alignment_status": {"enum": ["matched_headword", "inferred_sequence"]},
    "extraction_confidence": {"enum": ["high", "medium", "low"]},
    "multiple_separator_flag": {"enum": ["true", "false", true, false]},
    "headword_es_ocr": {"type": "string", "minLength": 1},
    "cora_ocr": {"type": "string", "minLength": 1},
    "raw_span_ocr": {"type": "string", "minLength": 1},
    "review_status": {"const": "pending_human_reconciliation"},
    "human_verified": {"enum": ["false", false]}
  }
}
