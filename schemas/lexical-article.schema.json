{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cora-historico-digital/schemas/lexical-article.schema.json",
  "title": "CHD Canonical Lexical Article",
  "type": "object",
  "required": ["article_id", "source_witness_id", "source_pdf_page", "headword_es_diplomatic", "cora_diplomatic", "review_status", "human_verified"],
  "properties": {
    "article_id": {"type": "string", "pattern": "^ORT1888-art-[0-9]{6}$"},
    "source_witness_id": {"const": "ORTEGA1888-TEPIC-IA"},
    "source_pdf_page": {"type": "integer", "minimum": 1},
    "source_printed_page": {"type": ["integer", "null"]},
    "headword_es_diplomatic": {"type": "string"},
    "cora_diplomatic": {"type": "string"},
    "source_span": {"type": ["string", "null"]},
    "editorial_notes": {"type": ["string", "null"]},
    "review_status": {"type": "string"},
    "human_verified": {"type": "boolean"}
  }
}
